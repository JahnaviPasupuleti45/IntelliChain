# Copy this file to .env and fill in the values. .env is git-ignored.

# LLM key (optional: the app works without one, using template reports).
# Free Groq key: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Or use Google Gemini instead: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Sign login tokens. Use a long random string outside local development.
SECRET_KEY=change-me

# Key that IoT devices (and simulate_iot.py) send in the X-API-Key header
DEVICE_API_KEY=dev-device-key
